{
  "compilerOptions": {
    "target": "es2019",
    "module": "esnext",
    "moduleResolution": "bundler",
    "moduleDetection": "legacy",
    "lib": ["es2019"],
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "experimentalDecorators": true,
    "esModuleInterop": true,
    "strict": true,
    "types": ["google-apps-script"]
  },
  "include": ["src/**/*"],
  "exclude": ["src/**/*.test.ts", "src/core/testing/**"]
}
