{
  "compilerOptions": {
    "target": "es2019",
    "module": "esnext",
    "moduleResolution": "bundler",
    "moduleDetection": "legacy",
    "lib": ["es2019"],
    "outDir": "./dist",
    "rootDir": "./src",
    "experimentalDecorators": true,
    "esModuleInterop": true,
    "strict": false,
    "types": ["google-apps-script"]
  },
  "include": ["src/**/*"]
}
